graph TB
    %% Layout Direction: Top to Bottom for clarity, though Context Diagrams are often centered.
    %% Entities (Rectangles)
    Student[Student]
    Counselor[Counselor]
    Admin[Administrator]

    %% System Process (Circle)
    System((Guidance Counseling<br>Management System<br>GCMS))

    %% Styling to match Standard DFD Notation
    classDef entity fill:#ffffff,stroke:#000000,stroke-width:2px;
    classDef process fill:#ffffff,stroke:#000000,stroke-width:2px,shape:circle;
    
    class Student,Counselor,Admin entity;
    class System process;

    %% Data Flows (Student <-> System)
    Student -- "Login Credentials, Appointment Request,<br>Wellness Intake Data" --> System
    System -- "Appointment Notification,<br>Dashboard Status Updates" --> Student

    %% Data Flows (Counselor <-> System)
    Counselor -- "Login Credentials, Session Notes,<br>Appointment Status (Confirm/Decline)" --> System
    System -- "Student Records (Profile/History),<br>Schedule Notifications" --> Counselor

    %% Data Flows (Admin <-> System)
    Admin -- "Login Credentials, User Account Data,<br>System Configuration" --> System
    System -- "System Reports (Stats/Lists),<br>Activity Logs" --> Admin
