graph TD
    %% Context Diagram (Level 0 DFD)
    %% SYMBOLS:
    %% - Process: Circle (The System)
    %% - Entity: Rectangle (Users)
    %% - Flow: Labeled Arrows (Data Packets)

    classDef process fill:#fff3e0,stroke:#e65100,stroke-width:3px;
    classDef entity fill:#e1f5fe,stroke:#01579b,stroke-width:2px;

    %% Central Process
    System((Guidance Counseling<br>Management System)):::process

    %% External Entities
    Student[Student]:::entity
    Counselor[Counselor]:::entity
    Admin[Administrator]:::entity

    %% Data Flows: Student
    Student -->|Registration Data| System
    Student -->|Booking Request & Wellness Info| System
    System -->|Appt Confirmation & Alerts| Student

    %% Data Flows: Counselor
    Counselor -->|Login Credentials| System
    Counselor -->|Session Notes & Status Updates| System
    System -->|Assigned Schedule & Student Data| Counselor

    %% Data Flows: Admin
    Admin -->|Admin Commands| System
    System -->|System Reports & User Lists| Admin